# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is git-ignored and must never be committed.
#
# Docker Compose reads this file automatically. For native development, the
# service hostnames below (`db`, `redis`) should be `localhost` instead.

# --- Django core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Number of reverse proxies in front of Django that each add an address to X-Forwarded-For. The guest
# throttles (including the 10/min guest CAD export) tell guests apart by the address that many hops from
# the right of that header; a header a client sends itself sits to the left and is ignored. 0 (the default)
# ignores the header and uses the socket address: right for local development with no proxy.
# docker-compose.prod.yml defaults to 1: nginx sets X-Forwarded-For to the single visitor address it gets
# from Cloudflare (see chapter 11.4). Count the proxies that APPEND to the header; do not guess higher,
# since too high a number trusts a value the client can choose.
# NUM_PROXIES=0

# --- PostgreSQL ---
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=postgres_Intg_osdag
DATABASE_USER=osdagdeveloper
DATABASE_PASSWORD=change-me

# --- Redis / Celery ---
# Required by docker-compose.prod.yml, which starts Redis with this password.
# The dev compose file runs Redis without one.
REDIS_PASSWORD=change-me
USE_REDIS_CACHE=false
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- InfluxDB (load-test metrics) ---
INFLUXDB_TOKEN=change-me
INFLUXDB_ADMIN_PASSWORD=change-me

# --- Grafana (load-test dashboards) ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Optional (see docker-compose.yml and backend/config/settings for defaults) ---
# DB_HOST_PORT=5433   # host port of the dev database; always bound to 127.0.0.1
# HOST_UID=1000
# HOST_GID=1000
# SMTP_HOST=
# SMTP_PORT=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
